# Copy to backend/.env and fill in real values. Never commit backend/.env.
# Used when running the backend directly on the host; Docker Compose overrides the database settings.
DATABASE_URL=postgresql://<db_user>:<db_password>@localhost:5432/<db_name>

ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Gmail SMTP: use a Google App Password for SMTP_PASSWORD, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
