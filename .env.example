# Copy to the project-root .env and replace the password with a unique value.
POSTGRES_DB=jaypilot_db
POSTGRES_USER=jaypilot_dev
POSTGRES_PASSWORD=replace-with-a-unique-long-random-value

# Production only (compose.prod.yaml): lowercase GitHub username/org that owns the GHCR images.
GHCR_OWNER=your-github-username
# Image tag to run: "latest" or a pinned "sha-<short commit>".
IMAGE_TAG=latest
